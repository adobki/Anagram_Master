# Anagram Master front end (Vite). Copy this file to `.env` in this folder (it is git-ignored) to override a value.
# Only variables starting with VITE_ are read, and they are visible to anyone who opens the built app,
# so never put a secret here. The app's secrets (database, Gmail) belong to the back end: see ../backend/.env.example.

# Where the dev server (`npm run dev`, `npm run dev:lan`) and `npm run preview` forward /api, /v1 and /static.
# The Flask server started with `python -m api.api` from src/backend listens on 5555.
# Use the same machine's address, not a hostname that resolves to IPv6 (the default below is deliberate).
VITE_API_TARGET=http://127.0.0.1:5555
