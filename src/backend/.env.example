# Anagram Master backend settings.
#
# Copy this file to `.env` in this folder (it is git-ignored) and fill in the values.
# `load_env.py` reads it at startup, but only fills in variables the operating system
# has not already set, so Render's dashboard and your shell always win.
# Every value below is a placeholder. Never commit real ones.

# ── Core ─────────────────────────────────────────────────────────────────────
# Fernet key for the player cookie. Generate one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Changing it signs every player out of their saved game.
am_cypher_key=generate-with-the-command-above

# MongoDB Atlas (mongodb+srv). Use the test database for local runs.
am_database_host=cluster0.xxxxx.mongodb.net
am_database_user=your-database-user
am_database_pass=your-database-password
am_database_name=AM_FE_tests

# Port for `python -m server` and `python -m api.api`. Default 5555.
PORT=5555

# How many reverse proxies sit in front of the app (Render: 1). It decides which
# X-Forwarded-For address is the player's, for the rate limits and the tickets
# page lock-out. Use 0 when the app is reached directly (local runs).
am_trusted_proxies=0

# ── Feedback emails (Gmail API) ──────────────────────────────────────────────
# Each feedback ticket is emailed to you, with its images attached. Leave these
# blank to skip emails: tickets are still saved and appear on the tickets page.
#
# One-time setup:
#   1. console.cloud.google.com: create or pick a project, then enable the "Gmail API".
#   2. APIs & Services > Credentials > Create credentials > OAuth client ID,
#      type "Web application", with this authorised redirect URI:
#        https://developers.google.com/oauthplayground
#      Copy the client ID and client secret below.
#   3. OAuth consent screen: set the publishing status to "In production"
#      (in "Testing", Google expires the refresh token after 7 days).
#   4. developers.google.com/oauthplayground: click the gear, tick "Use your own OAuth
#      credentials" and paste the client ID and secret. In Step 1 enter this one scope:
#        https://www.googleapis.com/auth/gmail.send
#      Authorise with the Gmail account that will send the mail, then in Step 2
#      "Exchange authorization code for tokens". Copy the refresh token.

# The Gmail account that sends the emails.
am_gmail_user=you@gmail.com
am_gmail_client_id=123456789012-abcdefghijklmnop.apps.googleusercontent.com
am_gmail_client_secret=GOCSPX-xxxxxxxxxxxxxxxxxxxx
am_gmail_refresh_token=1//0xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Where the alerts go. Defaults to am_gmail_user.
am_feedback_to=
# Sender display name. Defaults to "Anagram Master".
am_mail_from_name=Anagram Master
# The public address of this app, for links to a ticket's screen in the game
# (<address>/#feedback/...). Emails only carry that link when this is set; the
# tickets pages fall back to the address they were opened at.
am_app_url=http://localhost:5555

# ── Tickets page ─────────────────────────────────────────────────────────────
# /v1/tickets is protected by a login stored in MongoDB, not here: the `admin`
# collection document {"_id": "auth", "user": "...", "pass": "..."}. Create it once,
# for example from a Python shell in this folder:
#   from utils import db
#   db['admin'].update_one({'_id': 'auth'}, {'$set': {'user': 'me', 'pass': 'a-long-random-password'}}, upsert=True)
